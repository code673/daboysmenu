{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/script.js",
      "dest": "server.js",
      "methods": ["GET"]
    },
    {
      "src": "/style.css",
      "dest": "server.js",
      "methods": ["GET"]
    },
    {
      "src": "/index.html",
      "dest": "server.js",
      "methods": ["GET"]
    },
    {
      "src": "/admin.html",
      "dest": "server.js",
      "methods": ["GET"]
    },
    {
      "src": "/api/.*",
      "dest": "server.js",
      "methods": ["GET", "POST", "PUT", "DELETE"]
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
